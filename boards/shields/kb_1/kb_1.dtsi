#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "kb_1_layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &kb_1_layout;
        zmk,kscan = &kscan0;
    };

    kb_1_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <8>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)         RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)         RC(5,5) RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)         RC(6,5) RC(6,4) RC(6,3) RC(6,2) RC(6,1) RC(6,0)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(7,6) RC(7,5)                   RC(7,1) RC(7,0)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        col-gpios
            = <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        row-gpios
            = <&gpio0 2  GPIO_ACTIVE_HIGH> /* LROW0: D0 */
            , <&gpio0 3  GPIO_ACTIVE_HIGH> /* LROW1: D1 */
            , <&gpio1 11 GPIO_ACTIVE_HIGH> /* LROW2: D6 */
            , <&gpio0 10 GPIO_ACTIVE_HIGH> /* LROW3: D15 */
            , <&gpio0 15 GPIO_ACTIVE_HIGH> /* RROW0: D11 */
            , <&gpio1 5  GPIO_ACTIVE_HIGH> /* RROW1: D18 */
            , <&gpio0 4  GPIO_ACTIVE_HIGH> /* RROW2: D4 */
            , <&gpio1 3  GPIO_ACTIVE_HIGH> /* RROW3: D17 */
            ;

        wakeup-source;
    };

    pointing_listener: pointing_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};

/* D14/P0.09 (COL0) and D15/P0.10 (LROW3) must operate as GPIO, not NFC. */
&uicr {
    nfct-pins-as-gpios;
};

/* The XIAO defaults overlap matrix and trackball pins. */
&uart0 {
    status = "disabled";
};

&i2c1 {
    status = "disabled";
};

&pinctrl {
    kb_1_spi2_default: kb_1_spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    kb_1_spi2_sleep: kb_1_spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};

&kb_1_layout {
    kscan = <&kscan0>;
    transform = <&kb_1_transform>;
};
